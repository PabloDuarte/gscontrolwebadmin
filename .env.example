# Servidor SSH (DigitalOcean)
SSH_HOST=
SSH_PORT=22
SSH_USER=
SSH_KEY_PATH=
SSH_KEY_PASSPHRASE=

# Puerto local donde se expone el tunel
LOCAL_TUNNEL_PORT=3307

# MySQL (tal como se ve desde dentro del servidor)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# Base de control del panel
CONTROL_DB_NAME=gscontrol_clientes

# Cifrado de las contrasenas de las bases de cada empresa
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=

# Sesiones de Auth.js
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# Usuario inicial de INTECONAYC (solo se usa al sembrar)
ADMIN_EMAIL=
ADMIN_NOMBRE=
ADMIN_PASSWORD=
