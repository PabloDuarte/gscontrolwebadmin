# Supabase / Postgres (Project Settings → Database → Connection string URI)
DATABASE_URL=

# Opcional: app cliente con Supabase Auth (fase posterior)
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Sesiones de Auth.js
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# Correo (misma cuenta SMTP que GsControl ChecaApp: smtp.gmail.com:587)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=GsControl

# Usuario inicial de INTECONAYC (solo se usa al sembrar)
ADMIN_EMAIL=
ADMIN_NOMBRE=
ADMIN_PASSWORD=
